        <!-- Ícone reutilizável: <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCadeado}" Foreground="..." Width="20" /> -->
        <Style x:Key="Icone" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Width}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Canvas>
                        </Viewbox>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cor, fonte e tamanho do texto vêm da janela (herdados), para os botões poderem trocar a cor do texto -->
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TextoSuave" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Suave}" />
        </Style>

        <!-- Títulos em Bricolage Grotesque (h1 e títulos de cartão do site) -->
        <Style x:Key="TituloPagina" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="TituloCartao" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ErroCampo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Vermelho600}" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Logo "M": etiqueta amarela com sombra carimbada; o texto vai com MarcaLetra -->
        <Style x:Key="MarcaQuadrado" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource Etiqueta}" />
            <Setter Property="Effect" Value="{StaticResource SombraToldo}" />
        </Style>
        <Style x:Key="MarcaLetra" TargetType="TextBlock">
            <Setter Property="Text" Value="M" />
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MarcaNome" TargetType="TextBlock">
            <Setter Property="Text" Value="Mercado" />
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Etiqueta de preço (amarela, como na gôndola): Border EtiquetaPreco com um TextBlock EtiquetaPrecoTexto -->
        <Style x:Key="EtiquetaPreco" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Etiqueta}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,2,10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Effect" Value="{StaticResource SombraEtiqueta}" />
        </Style>
        <Style x:Key="EtiquetaPrecoTexto" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
        </Style>

        <!-- Campos de texto -->
        <Style x:Key="CampoBase" TargetType="Control">
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Grid>
                            <Border x:Name="Brilho" CornerRadius="8" Margin="-3" BorderThickness="3"
                                    BorderBrush="{StaticResource Verde50}" Visibility="Collapsed" />
                            <Border x:Name="Borda" CornerRadius="6" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Toldo}" />
                                <Setter TargetName="Borda" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Brilho" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Tag" Value="invalido">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Vermelho600}" />
                                <Setter TargetName="Brilho" Property="BorderBrush" Value="{StaticResource Vermelho50}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource CampoBase}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource CampoBase}" />

        <!-- Botões: o principal tem a "sola" verde-escura de 3 px embaixo e afunda ao clicar -->
        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Verde600}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="{StaticResource ToldoEscuro}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Conteudo" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Toldo}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="BorderThickness" Value="0,2,0,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secundário: papel com borda forte; ao passar o mouse a borda fica cor de tinta -->
        <Style x:Key="BotaoFantasma" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="{StaticResource Cartao}" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="BorderBrush" Value="{StaticResource LinhaForte}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Tinta}" />
                                <Setter TargetName="Borda" Property="Background" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão vermelho de exclusão (igual a .btn-danger do site) -->
        <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="{StaticResource Vermelho600}" />
            <Setter Property="BorderBrush" Value="{StaticResource Vermelho700}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#9E2F17" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="BorderThickness" Value="0,2,0,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão amarelo de etiqueta (o "Acessar sistema" no toldo do site) -->
        <Style x:Key="BotaoEtiqueta" TargetType="Button" BasedOn="{StaticResource BotaoPrimario}">
            <Setter Property="Background" Value="{StaticResource Etiqueta}" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToldoEscuro}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivelClaro}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource EtiquetaHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Borda" Property="BorderThickness" Value="0,2,0,1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão que parece link de texto -->
        <Style x:Key="BotaoLink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Toldo}" />
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Texto" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Background="Transparent" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Texto" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkSuave" TargetType="Button" BasedOn="{StaticResource BotaoLink}">
            <Setter Property="Foreground" Value="{StaticResource Suave}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Cartões: papel, borda fina e sem sombra -->
        <Style x:Key="CartaoBorda" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Cartao}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Janela por cima da tela (cadastros, confirmações): faixa verde de 6 px no alto e sem sombra
             (efeito no Border deixaria o texto de dentro borrado) -->
        <Style x:Key="CartaoJanela" TargetType="Border" BasedOn="{StaticResource CartaoBorda}">
            <Setter Property="BorderBrush" Value="{StaticResource Toldo}" />
            <Setter Property="BorderThickness" Value="1,6,1,1" />
        </Style>

        <!-- Chamada acima do título (igual a .eyebrow do site): texto verde sublinhado, sem pílula -->
        <Style x:Key="Pilula" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Toldo}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Avisos (erro, atenção, sucesso): faixa grossa à esquerda -->
        <Style x:Key="Aviso" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="BorderThickness" Value="4,1,1,1" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <!-- Faixa de contadores clicáveis (Estoque e Fornecedores): filtra a lista. Vai dentro de um
             Border FaixaKpis; Tag="ativo" marca o escolhido. O Painel tem o seu próprio "Kpi". -->
        <Style x:Key="FaixaKpis" TargetType="Border" BasedOn="{StaticResource CartaoBorda}">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="MinHeight" Value="104" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Borda" Background="Transparent" BorderBrush="{StaticResource LinhaTracejadaForte}"
                                    BorderThickness="0,0,1,1" Padding="16,14">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marca" Height="4" VerticalAlignment="Bottom" Margin="0,0,1,1"
                                    Background="{StaticResource Etiqueta}" Visibility="Collapsed" />
                            <Rectangle x:Name="Foco" Margin="3" Stroke="{StaticResource Toldo}" StrokeThickness="3"
                                       RadiusX="4" RadiusY="4" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource LinhaHover}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource EtiquetaClara}" />
                                <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiRotulo" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiValor" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FonteTitulo}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Filtro (igual a .chip do site), como etiquetinha; Tag="ativo" marca o selecionado (amarelo) -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{StaticResource Cartao}" BorderBrush="{StaticResource LinhaForte}" BorderThickness="1.5"
                                CornerRadius="4" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Tinta}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Etiqueta}" />
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Tinta}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cabeçalho de tabela: texto miúdo suave; a linha de baixo é cor de tinta (CabecalhoTabela) -->
        <Style x:Key="Cabecalho" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="CabecalhoTabela" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Tinta}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,8" />
        </Style>

        <!-- Lista de escolha (mesmo visual dos campos de texto) -->
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Brilho" CornerRadius="8" Margin="-3" BorderThickness="3"
                                    BorderBrush="{StaticResource Verde50}" Visibility="Collapsed" />
                            <ToggleButton x:Name="Botao" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Borda" Background="White" BorderBrush="{StaticResource LinhaForte}" BorderThickness="1" CornerRadius="6">
                                            <Path Data="M0 0l5 5 5-5" Stroke="{StaticResource Tinta}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Tinta}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Toldo}" />
                                                <Setter TargetName="Borda" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="foco">
                                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Toldo}" />
                                                <Setter TargetName="Borda" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="14,0,38,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="{StaticResource LinhaForte}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" Padding="0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Brilho" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Botao" Property="Tag" Value="foco" />
                            </Trigger>
                            <Trigger Property="Tag" Value="invalido">
                                <Setter TargetName="Brilho" Property="BorderBrush" Value="{StaticResource Vermelho600}" />
                                <Setter TargetName="Brilho" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fundo" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource EtiquetaClara}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Toldo}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Tinta}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivel}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource FonteTexto}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Creme}" />
            <Setter Property="Background" Value="{StaticResource Tinta}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Application.Resources>
</Application>
