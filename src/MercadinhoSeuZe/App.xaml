<Application x:Class="MercadinhoSeuZe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Tema "mercadinho de bairro", igual ao css/tema.css do site: papel, toldo verde listrado,
             etiqueta amarela de preço e vermelho tomate. Cantos de 3 a 8 px, sem sombra borrada. -->
        <Color x:Key="CorVerde800">#143F27</Color>
        <Color x:Key="CorVerde600">#23703F</Color>
        <SolidColorBrush x:Key="Verde800" Color="#143F27" />
        <SolidColorBrush x:Key="Verde700" Color="#1E5B38" />
        <SolidColorBrush x:Key="Verde600" Color="#23703F" />
        <SolidColorBrush x:Key="Verde100" Color="#C9DCC1" />
        <SolidColorBrush x:Key="Verde50" Color="#E3EEDD" />
        <SolidColorBrush x:Key="Azul600" Color="#285A96" />
        <SolidColorBrush x:Key="Azul50" Color="#E4ECF6" />
        <SolidColorBrush x:Key="Ambar700" Color="#7A4D00" />
        <SolidColorBrush x:Key="Ambar50" Color="#FBEFCB" />
        <SolidColorBrush x:Key="Vermelho600" Color="#B5371C" />
        <SolidColorBrush x:Key="Vermelho700" Color="#7D2412" />
        <SolidColorBrush x:Key="Vermelho50" Color="#FBE3DC" />
        <!-- Bordas dos avisos coloridos -->
        <SolidColorBrush x:Key="BordaAvisoVerde" Color="#B7CFAE" />
        <SolidColorBrush x:Key="BordaAvisoAmbar" Color="#E8D08A" />
        <SolidColorBrush x:Key="BordaAvisoVermelho" Color="#EDB9A9" />
        <SolidColorBrush x:Key="BordaAvisoAzul" Color="#BCCDE6" />
        <!-- Cores das categorias do estoque (mesma lógica: fundo claro "50" + cor forte "600") -->
        <SolidColorBrush x:Key="Roxo600" Color="#6B46C1" />
        <SolidColorBrush x:Key="Roxo50" Color="#F1ECFB" />
        <SolidColorBrush x:Key="Ciano600" Color="#0E7C86" />
        <SolidColorBrush x:Key="Ciano50" Color="#E6F4F5" />
        <SolidColorBrush x:Key="Rosa600" Color="#B83280" />
        <SolidColorBrush x:Key="Rosa50" Color="#FBEAF3" />
        <SolidColorBrush x:Key="Indigo600" Color="#4C51BF" />
        <SolidColorBrush x:Key="Indigo50" Color="#ECEEFB" />
        <SolidColorBrush x:Key="Marrom600" Color="#8B4A2B" />
        <SolidColorBrush x:Key="Marrom50" Color="#F6EDE7" />
        <SolidColorBrush x:Key="Tinta" Color="#24211C" />
        <SolidColorBrush x:Key="Suave" Color="#655D50" />
        <SolidColorBrush x:Key="Placeholder" Color="#857C6E" />
        <SolidColorBrush x:Key="Linha" Color="#E2D9C8" />
        <!-- Borda de campo, botão secundário e chip (3,6:1 sobre o cartão) -->
        <SolidColorBrush x:Key="LinhaForte" Color="#8E8473" />
        <SolidColorBrush x:Key="Fundo" Color="#F5EFE3" />
        <SolidColorBrush x:Key="Cartao" Color="#FFFDF8" />
        <SolidColorBrush x:Key="Toldo" Color="#1E5B38" />
        <SolidColorBrush x:Key="ToldoEscuro" Color="#143F27" />
        <SolidColorBrush x:Key="Creme" Color="#FBF6EA" />
        <!-- Texto claro sobre o verde do toldo (menu lateral e painel do login) -->
        <SolidColorBrush x:Key="CremeSuave" Color="#D9E6D5" />
        <SolidColorBrush x:Key="Etiqueta" Color="#F6CF3A" />
        <SolidColorBrush x:Key="EtiquetaHover" Color="#FFDB4F" />
        <!-- Fundo amarelinho de item escolhido (indicador ativo, sugestão, resultado da busca) -->
        <SolidColorBrush x:Key="EtiquetaClara" Color="#FDF3D4" />
        <SolidColorBrush x:Key="LinhaHover" Color="#FFFAF0" />
        <SolidColorBrush x:Key="LinhaAberta" Color="#F8F2E4" />
        <SolidColorBrush x:Key="BrancoTransl82" Color="#D1FFFFFF" />
        <SolidColorBrush x:Key="BrancoTransl75" Color="#BFFFFFFF" />
        <SolidColorBrush x:Key="CremeTransl60" Color="#99FBF6EA" />
        <SolidColorBrush x:Key="CremeTransl40" Color="#66FBF6EA" />
        <SolidColorBrush x:Key="CremeTransl20" Color="#33FBF6EA" />
        <SolidColorBrush x:Key="CremeTransl10" Color="#1AFBF6EA" />
        <!-- Fundo escuro atrás das janelas por cima da tela -->
        <SolidColorBrush x:Key="FundoJanela" Color="#8C24211C" />

        <!-- Linha tracejada (tabelas como caderno de anotação): xadrez de 3 px, serve deitada e em pé -->
        <DrawingBrush x:Key="LinhaTracejada" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Viewbox="0,0,6,6" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#E2D9C8" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="LinhaTracejadaForte" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Viewbox="0,0,6,6" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#8E8473" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Sobre o toldo verde (mini resumo do login) -->
        <DrawingBrush x:Key="LinhaTracejadaClara" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute" Viewbox="0,0,6,6" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#66FBF6EA" Geometry="M0,0 H3 V3 H0 Z M3,3 H6 V6 H3 Z" />
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Toldo listrado com a borda recortada em meia-lua (topo do site, menu lateral e login) -->
        <DrawingBrush x:Key="ToldoListrado" TileMode="Tile" Viewport="0,0,44,18" ViewportUnits="Absolute" Viewbox="0,0,44,18" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1E5B38" Geometry="M0,0 H22 V8 A11,11 0 0 1 0,8 Z" />
                    <GeometryDrawing Brush="#FBF6EA" Geometry="M22,0 H44 V8 A11,11 0 0 1 22,8 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <!-- Sobre fundo verde, a listra escura aparece no lugar da verde -->
        <DrawingBrush x:Key="ToldoListradoEscuro" TileMode="Tile" Viewport="0,0,44,18" ViewportUnits="Absolute" Viewbox="0,0,44,18" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#143F27" Geometry="M0,0 H22 V8 A11,11 0 0 1 0,8 Z" />
                    <GeometryDrawing Brush="#FBF6EA" Geometry="M22,0 H44 V8 A11,11 0 0 1 22,8 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="FaixaToldo" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="{StaticResource ToldoListrado}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Sombra "carimbada" (deslocada, sem borrão), no lugar das sombras borradas -->
        <DropShadowEffect x:Key="SombraCartao" BlurRadius="0" ShadowDepth="8" Direction="315" Opacity="0.12" Color="#24211C" />
        <DropShadowEffect x:Key="SombraJanela" BlurRadius="0" ShadowDepth="6" Direction="315" Opacity="0.3" Color="#24211C" />
        <DropShadowEffect x:Key="SombraEtiqueta" BlurRadius="0" ShadowDepth="2.8" Direction="315" Opacity="0.85" Color="#24211C" />
        <DropShadowEffect x:Key="SombraToldo" BlurRadius="0" ShadowDepth="2.8" Direction="315" Opacity="1" Color="#143F27" />

        <!-- Fontes embutidas (Assets/Fontes, licença SIL OFL): Bricolage Grotesque nos títulos e números, Figtree no texto -->
        <FontFamily x:Key="FonteTexto">./Assets/Fontes/#Figtree, Segoe UI</FontFamily>
        <FontFamily x:Key="FonteTitulo">./Assets/Fontes/#Bricolage Grotesque, Segoe UI</FontFamily>

        <!-- Foco pelo teclado bem visível: contorno verde-escuro de 3 px afastado 2 px (amarelo sobre o verde) -->
        <Style x:Key="FocoVisivel">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-5" Stroke="{StaticResource Toldo}" StrokeThickness="3" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FocoVisivelClaro">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-5" Stroke="{StaticResource Etiqueta}" StrokeThickness="3" RadiusX="7" RadiusY="7" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

