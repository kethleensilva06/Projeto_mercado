<UserControl x:Class="MercadinhoSeuZe.Views.AreaInternaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <UserControl.Resources>
        <!-- Item do menu lateral (igual a .nav-item do site): texto creme sobre o toldo, ativo em etiqueta amarela -->
        <Style x:Key="ItemMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CremeSuave}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivelClaro}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource CremeTransl10}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Etiqueta}" />
                                <Setter TargetName="Borda" Property="Effect" Value="{StaticResource SombraToldo}" />
                                <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão de contorno claro sobre o toldo (Sair e Menu) -->
        <Style x:Key="BotaoNoToldo" TargetType="Button" BasedOn="{StaticResource BotaoFantasma}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Creme}" />
            <Setter Property="BorderBrush" Value="{StaticResource CremeTransl60}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVisivelClaro}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="White" />
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource CremeTransl10}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topo no celular / janela estreita: o toldo verde, com a listra por cima do conteúdo -->
        <Border x:Name="BarraCompacta" Grid.ColumnSpan="2" Background="{StaticResource Toldo}" Height="64" Padding="16,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Style="{StaticResource MarcaLetra}" />
                    </Border>
                    <TextBlock Style="{StaticResource MarcaNome}" Foreground="{StaticResource Creme}" />
                </StackPanel>
                <Button Content="Menu" Style="{StaticResource BotaoNoToldo}" Height="38" Padding="14,0"
                        FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AlternarMenu_Click" />
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer x:Name="Rolagem" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AreaConteudo" Margin="40,32,40,48">
                <!-- Aviso de modo de teste -->
                <Border x:Name="AvisoTeste" Style="{StaticResource Aviso}" Background="{StaticResource Ambar50}" BorderBrush="{StaticResource BordaAvisoAmbar}"
                        Padding="14,10" Margin="0,0,0,24">
                    <DockPanel>
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}"
                                        Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Foreground="{StaticResource Ambar700}" FontSize="14">
                            <Run FontWeight="SemiBold" Text="Modo de teste." />
                            <Run x:Name="AvisoTesteTexto" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="Pagina" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- Listra do toldo embaixo da barra da janela estreita -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FaixaToldo}" VerticalAlignment="Top"
                Visibility="{Binding Visibility, ElementName=BarraCompacta}" />

        <!-- Fundo escuro do menu aberto em janela estreita -->
        <Border x:Name="FundoMenu" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource FundoJanela}" Visibility="Collapsed"
                MouseLeftButtonDown="FundoMenu_Click" />

        <!-- Menu lateral: o toldo verde, com a listra escura no alto -->
        <Border x:Name="MenuLateral" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="264" HorizontalAlignment="Left"
                Background="{StaticResource Toldo}" Padding="14,0,14,20">
            <DockPanel>
                <Border x:Name="ToldoMenu" DockPanel.Dock="Top" Style="{StaticResource FaixaToldo}" Background="{StaticResource ToldoListradoEscuro}"
                        Margin="-14,0,-14,18" />
                <StackPanel x:Name="MarcaMenu" DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,10,22">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Style="{StaticResource MarcaLetra}" />
                    </Border>
                    <TextBlock Style="{StaticResource MarcaNome}" Foreground="{StaticResource Creme}" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource CremeTransl20}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="8,6">
                            <Border Width="36" Height="36" CornerRadius="4" Background="{StaticResource Etiqueta}" Margin="0,0,10,0">
                                <TextBlock x:Name="Avatar" Foreground="{StaticResource Tinta}" FontFamily="{StaticResource FonteTitulo}" FontWeight="ExtraBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NomeUsuario" FontSize="14" FontWeight="Bold" Foreground="White" />
                                <TextBlock x:Name="PerfilUsuario" FontSize="12" Foreground="{StaticResource CremeSuave}" />
                            </StackPanel>
                        </DockPanel>
                        <Button x:Name="BotaoSair" AutomationProperties.Name="Sair" Style="{StaticResource BotaoNoToldo}" Height="38"
                                FontSize="14" Margin="0,10,0,0" Click="Sair_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeSair}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Margin="0,0,8,0" />
                                <TextBlock Text="Sair" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ItensMenu" />
            </DockPanel>
        </Border>

        <!-- Janela por cima da tela (cadastros e confirmações); Esc fecha -->
        <Grid x:Name="Sobreposicao" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="{StaticResource FundoJanela}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="JanelaAtual" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
            </ScrollViewer>
        </Grid>

        <!-- Aviso rápido (toast), com a sombra carimbada amarela -->
        <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Tinta}" CornerRadius="4" Padding="18,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="4.2" Direction="315" Opacity="1" Color="#F6CF3A" />
            </Border.Effect>
            <TextBlock x:Name="ToastTexto" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
