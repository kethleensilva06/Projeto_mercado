<UserControl x:Class="MercadinhoSeuZe.Views.CaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <StackPanel>
        <!-- Cabeçalho (igual a caixa.html) -->
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="Caixa" Style="{StaticResource TituloPagina}" />
            <TextBlock x:Name="Subtitulo" Text="Registro de vendas do dia" Style="{StaticResource TextoSuave}" />
        </StackPanel>

        <!-- Erro ao ler o banco -->
        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource BordaAvisoVermelho}"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="TentarDeNovo_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Caixa fechado: abrir com o troco inicial -->
        <Border x:Name="PainelAbrir" Style="{StaticResource CartaoBorda}" Padding="28,24" Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <ContentControl DockPanel.Dock="Left" Style="{StaticResource Icone}" Tag="{StaticResource IconeCaixaRegistradora}"
                                Foreground="{StaticResource Toldo}" Width="40" VerticalAlignment="Top" Margin="0,2,22,0" />
                <StackPanel>
                    <TextBlock Text="O caixa está fechado" Style="{StaticResource TituloCartao}" FontSize="20" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource TextoSuave}" FontSize="14" Margin="0,0,0,18"
                               Text="Conte o dinheiro que está na gaveta para o troco e abra o caixa para começar a vender." />
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,14,0">
                            <TextBlock Text="Troco inicial (R$)" Style="{StaticResource Rotulo}" />
                            <TextBox x:Name="TrocoInicial" Text="0,00" MaxLength="12" KeyDown="TrocoInicial_KeyDown"
                                     AutomationProperties.Name="Troco inicial em reais" />
                            <TextBlock x:Name="TrocoInicialErro" Style="{StaticResource ErroCampo}" />
                        </StackPanel>
                        <Button x:Name="BotaoAbrir" Content="Abrir caixa" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Top"
                                Margin="0,26,0,0" Click="AbrirCaixa_Click" />
                    </WrapPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Caixa já fechado (semana 6): só mostra o resumo -->
        <Border x:Name="AvisoFechado" Style="{StaticResource Aviso}" Background="{StaticResource Azul50}" BorderBrush="{StaticResource BordaAvisoAzul}"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ver o fechamento" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Azul600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="VerFechamento_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFechamento}" Foreground="{StaticResource Azul600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoFechadoTexto" Foreground="{StaticResource Azul600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Venda em andamento -->
        <Grid x:Name="AreaVenda" Margin="0,0,0,24" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColunaPagamento" Width="340" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Itens da venda -->
            <Border x:Name="CartaoItens" Style="{StaticResource CartaoBorda}" Padding="24,22" Margin="0,0,20,0" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="Busca" Padding="42,0,14,0" MaxLength="60" TextChanged="Busca_TextChanged" PreviewKeyDown="Busca_PreviewKeyDown"
                                 AutomationProperties.Name="Código de barras ou nome do produto" />
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCodigoBarras}" Foreground="{StaticResource Suave}"
                                        Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="DicaBusca" Text="Passe o leitor ou digite o nome do produto (F2)" Foreground="{StaticResource Placeholder}" FontSize="15"
                                   VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock x:Name="BuscaErro" Style="{StaticResource ErroCampo}" />
                    <Border x:Name="CaixaResultados" BorderBrush="{StaticResource LinhaForte}" BorderThickness="1" CornerRadius="4"
                            Margin="0,6,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="Resultados" />
                    </Border>

                    <!-- Carrinho -->
                    <StackPanel x:Name="Carrinho" Margin="0,16,0,0">
                        <Border Style="{StaticResource CabecalhoTabela}">
                            <Grid x:Name="CabecalhoCarrinho">
                                <TextBlock Grid.Column="0" Text="Produto" Style="{StaticResource Cabecalho}" />
                                <TextBlock Grid.Column="1" Text="Qtd. / peso" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="Preço" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="Itens" />
                    </StackPanel>
                    <StackPanel x:Name="SemItens" HorizontalAlignment="Center" Margin="0,32,0,20" MaxWidth="420">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCesta}" Foreground="{StaticResource LinhaForte}" Width="40"
                                        HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Nenhum item na venda" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource TextoSuave}" FontSize="14" TextAlignment="Center" Margin="0,4,0,0"
                                   Text="Os itens ficam reservados enquanto a venda está aberta e só saem do estoque depois do pagamento." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Pagamento -->
            <Border x:Name="CartaoPagamento" Grid.Column="1" Style="{StaticResource CartaoBorda}" Padding="24,22" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Total da venda" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,8,0,6">
                        <TextBlock x:Name="TotalVenda" Text="R$ 0,00" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="34" />
                    </Border>
                    <TextBlock x:Name="QuantidadeItens" Text="Nenhum item" Style="{StaticResource TextoSuave}" FontSize="13" />

                    <TextBlock Text="Forma de pagamento" Style="{StaticResource Rotulo}" Margin="0,22,0,8" />
                    <WrapPanel x:Name="Formas" />
                    <TextBlock x:Name="FormaErro" Style="{StaticResource ErroCampo}" Margin="0,0,0,0" />

                    <StackPanel x:Name="PainelDinheiro" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="Valor recebido (R$)" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <TextBox x:Name="Recebido" MaxLength="12" TextChanged="Recebido_TextChanged" AutomationProperties.Name="Valor recebido em reais" />
                            <TextBlock x:Name="DicaRecebido" Text="vazio = valor exato" Foreground="{StaticResource Placeholder}" FontSize="15"
                                       VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock x:Name="RecebidoErro" Style="{StaticResource ErroCampo}" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Right" x:Name="Troco" Text="R$ 0,00" FontFamily="{StaticResource FonteTitulo}" FontSize="22" FontWeight="ExtraBold" />
                            <TextBlock Text="Troco" Style="{StaticResource TextoSuave}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <Button x:Name="BotaoFinalizar" Style="{StaticResource BotaoPrimario}" Height="52" FontSize="16" Margin="0,22,0,0"
                            AutomationProperties.Name="Finalizar venda" Click="Finalizar_Click">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCheck}" Foreground="White" Width="18" Margin="0,0,8,0" />
                            <TextBlock Text="Finalizar venda (F4)" />
                        </StackPanel>
                    </Button>
                    <Button Content="Cancelar venda" Style="{StaticResource LinkSuave}" HorizontalAlignment="Center" Margin="0,14,0,0"
                            Click="CancelarVenda_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Resumo do dia (visível para todos os perfis) -->
        <UniformGrid x:Name="Resumo" Columns="3" Margin="0,0,-16,4">
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas hoje" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Total" Text="—" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="24" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas realizadas" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Quantidade" Text="—" FontFamily="{StaticResource FonteTitulo}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Ticket médio" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Ticket" Text="—" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="24" />
                    </Border>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Vendas de hoje -->
        <Border Style="{StaticResource CartaoBorda}" Padding="24,22">
            <StackPanel>
                <TextBlock Text="Vendas de hoje" Style="{StaticResource TituloCartao}" Margin="0,0,0,10" />
                <StackPanel x:Name="Vendas" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
