<UserControl x:Class="MercadinhoSeuZe.Views.CaixaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <StackPanel>
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="Caixa" Style="{StaticResource TituloPagina}" />
            <TextBlock Text="Registro de vendas do dia" Style="{StaticResource TextoSuave}" />
        </StackPanel>

        <!-- Resumo de vendas do dia (visível para todos os perfis) -->
        <UniformGrid x:Name="Resumo" Columns="3" Margin="0,0,-16,4">
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas hoje" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Total" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="26" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas realizadas" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Quantidade" FontFamily="{StaticResource FonteTitulo}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Ticket médio" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Ticket" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="26" />
                    </Border>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource CartaoBorda}" Padding="24,22">
            <StackPanel>
                <TextBlock Text="Em desenvolvimento" FontFamily="{StaticResource FonteTitulo}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource TextoSuave}"
                           Text="Esta tela será desenvolvida na etapa do Caixa (semana 5): montagem da venda, pagamento e baixa automática no estoque." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
