<UserControl x:Class="MercadinhoSeuZe.Views.LandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <Grid>
        <DockPanel>
            <!-- Topo: o toldo verde do mercadinho -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Toldo}">
                <DockPanel x:Name="Topo" Height="64" MaxWidth="1120" Margin="24,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource MarcaQuadrado}">
                            <TextBlock Style="{StaticResource MarcaLetra}" />
                        </Border>
                        <TextBlock Style="{StaticResource MarcaNome}" Foreground="{StaticResource Creme}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Contato" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Creme}" FontSize="15" VerticalAlignment="Center"
                                Margin="0,0,20,0" Click="AbrirContato_Click" FocusVisualStyle="{StaticResource FocoVisivelClaro}" />
                        <Button Content="Acessar sistema" Style="{StaticResource BotaoEtiqueta}" Height="38" Padding="16,0"
                                FontSize="14" Click="AcessarSistema_Click" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Rodapé -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Fundo}" Padding="0,14">
                <TextBlock Text="Mercado · contato@mercado.com.br · (11) 4000-0000" Style="{StaticResource TextoSuave}"
                           FontSize="13" HorizontalAlignment="Center" />
            </Border>

            <!-- Hero -->
            <Grid Background="{StaticResource Fundo}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="1120" Margin="24,56,24,40" VerticalAlignment="Center">
                        <Grid x:Name="HeroGrade">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition x:Name="ColunaPrevia" Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,56,0" x:Name="HeroTexto">
                                <Border Style="{StaticResource Pilula}" Margin="0,0,0,16">
                                    <TextBlock Text="Gestão para mercados" Foreground="{StaticResource Toldo}" FontSize="13" FontWeight="Bold" />
                                </Border>
                                <TextBlock x:Name="Titulo" Text="O sistema completo para o seu mercado" FontFamily="{StaticResource FonteTitulo}" FontSize="50" FontWeight="ExtraBold"
                                           LineHeight="53" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,18" />
                                <TextBlock Style="{StaticResource TextoSuave}" FontSize="18" MaxWidth="520" HorizontalAlignment="Left" Margin="0,0,0,26"
                                           Text="Login, estoque, fornecedores e caixa integrados, com fechamento automático do dia — tudo em um só lugar." />
                                <WrapPanel>
                                    <Button Content="Acessar sistema" Style="{StaticResource BotaoPrimario}" Margin="0,0,12,8" Click="AcessarSistema_Click" />
                                    <Button Content="Fale com a gente" Style="{StaticResource BotaoFantasma}" Margin="0,0,0,8" Click="AbrirContato_Click" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Prévia ilustrativa do resumo do dia: papel levemente torto, com as etiquetas de preço -->
                            <Border x:Name="Previa" Grid.Column="1" Style="{StaticResource CartaoBorda}" CornerRadius="2" Padding="24"
                                    Effect="{StaticResource SombraCartao}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,8">
                                <Border.RenderTransform>
                                    <RotateTransform Angle="1.2" />
                                </Border.RenderTransform>
                                <StackPanel>
                                    <TextBlock Text="Resumo do dia" FontFamily="{StaticResource FonteTitulo}" FontSize="20" FontWeight="ExtraBold" Margin="0,0,0,16" />
                                    <UniformGrid Columns="2" Margin="0,0,0,18">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Vendas hoje" Style="{StaticResource TextoSuave}" FontSize="12" />
                                            <Border Style="{StaticResource EtiquetaPreco}" Margin="0,4,0,0">
                                                <TextBlock Text="R$ 1.284,50" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="20" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="Ticket médio" Style="{StaticResource TextoSuave}" FontSize="12" />
                                            <Border Style="{StaticResource EtiquetaPreco}" Margin="0,4,0,0">
                                                <TextBlock Text="R$ 40,10" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="20" />
                                            </Border>
                                        </StackPanel>
                                    </UniformGrid>
                                    <Border BorderBrush="{StaticResource Vermelho600}" BorderThickness="3,0,0,0" Padding="10,2" Margin="0,0,0,12">
                                        <TextBlock Text="Leite integral 1L com estoque baixo (4 un.)" Foreground="{StaticResource Vermelho600}" FontSize="13" FontWeight="SemiBold" />
                                    </Border>
                                    <ItemsControl x:Name="LinhasPrevia">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LinhaTracejadaForte}" BorderThickness="0,1,0,0" Padding="2,10">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Value}" Style="{StaticResource TextoSuave}" FontSize="14" DockPanel.Dock="Right" />
                                                        <TextBlock Text="{Binding Key}" FontSize="14" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Módulos do sistema: uma faixa só, separada por linhas tracejadas -->
                        <Border BorderBrush="{StaticResource Tinta}" BorderThickness="0,2,0,0" Margin="0,56,0,0">
                            <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1">
                                <UniformGrid x:Name="Modulos" Columns="3">
                                    <Border Padding="22,20">
                                        <DockPanel>
                                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaixaProduto}" Foreground="{StaticResource Toldo}" Width="30"
                                                            VerticalAlignment="Top" Margin="0,0,14,0" />
                                            <StackPanel>
                                                <TextBlock Text="Estoque sempre atualizado" Style="{StaticResource TituloCartao}" Margin="0,0,0,2" />
                                                <TextBlock Text="Controle de produtos, validade e alerta de estoque baixo." Style="{StaticResource TextoSuave}" FontSize="14" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border x:Name="Modulo2" Padding="22,20" BorderBrush="{StaticResource LinhaTracejadaForte}" BorderThickness="1,0,0,0">
                                        <DockPanel>
                                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaminhao}" Foreground="{StaticResource Toldo}" Width="30"
                                                            VerticalAlignment="Top" Margin="0,0,14,0" />
                                            <StackPanel>
                                                <TextBlock Text="Fornecedores organizados" Style="{StaticResource TituloCartao}" Margin="0,0,0,2" />
                                                <TextBlock Text="Cadastro e pedidos de reposição em um só lugar." Style="{StaticResource TextoSuave}" FontSize="14" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border x:Name="Modulo3" Padding="22,20" BorderBrush="{StaticResource LinhaTracejadaForte}" BorderThickness="1,0,0,0">
                                        <DockPanel>
                                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaixaRegistradora}" Foreground="{StaticResource Toldo}" Width="30"
                                                            VerticalAlignment="Top" Margin="0,0,14,0" />
                                            <StackPanel>
                                                <TextBlock Text="Caixa rápido e simples" Style="{StaticResource TituloCartao}" Margin="0,0,0,2" />
                                                <TextBlock Text="Venda, pagamento e comprovante em poucos cliques." Style="{StaticResource TextoSuave}" FontSize="14" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Listra do toldo por cima do começo da página -->
                <Border Style="{StaticResource FaixaToldo}" VerticalAlignment="Top" />
            </Grid>
        </DockPanel>

        <!-- Janela "Fale com a gente" -->
        <Grid x:Name="JanelaContato" Visibility="Collapsed">
            <Border Background="{StaticResource FundoJanela}" MouseLeftButtonDown="FundoContato_Click" />
            <Border Style="{StaticResource CartaoJanela}" Padding="24,24,24,20" Width="460" Margin="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                                VerticalAlignment="Top" Click="FecharContato_Click" ToolTip="Fechar" />
                        <StackPanel>
                            <TextBlock Text="Fale com a gente" FontFamily="{StaticResource FonteTitulo}" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                            <TextBlock Text="Deixe seu contato e retornamos em breve." Style="{StaticResource TextoSuave}" FontSize="14" />
                        </StackPanel>
                    </DockPanel>

                    <Border x:Name="AvisoContato" Style="{StaticResource Aviso}" Visibility="Collapsed"
                            Background="{StaticResource Verde50}" BorderBrush="{StaticResource BordaAvisoVerde}">
                        <TextBlock x:Name="AvisoContatoTexto" Foreground="{StaticResource Verde700}" FontSize="14" />
                    </Border>

                    <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="ContatoNome" MaxLength="120" />
                    <TextBlock x:Name="ContatoNomeErro" Style="{StaticResource ErroCampo}" />

                    <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                    <TextBox x:Name="ContatoEmail" MaxLength="200" />
                    <TextBlock x:Name="ContatoEmailErro" Style="{StaticResource ErroCampo}" />

                    <TextBlock Text="Mensagem" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
                    <TextBox x:Name="ContatoMensagem" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="84" Padding="14,10" VerticalContentAlignment="Top" />
                    <TextBlock x:Name="ContatoMensagemErro" Style="{StaticResource ErroCampo}" />

                    <Button x:Name="BotaoEnviarContato" Content="Enviar mensagem" Style="{StaticResource BotaoPrimario}"
                            Margin="0,18,0,0" Click="EnviarContato_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
