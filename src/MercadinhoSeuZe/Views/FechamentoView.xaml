<UserControl x:Class="MercadinhoSeuZe.Views.FechamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <StackPanel>
        <!-- Cabeçalho -->
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="Fechamento do dia" Style="{StaticResource TituloPagina}" />
            <TextBlock x:Name="Subtitulo" Text="Carregando…" Style="{StaticResource TextoSuave}" />
        </StackPanel>

        <!-- Erro ao ler o banco -->
        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource BordaAvisoVermelho}"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="TentarDeNovo_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Caixa de hoje ainda não aberto -->
        <Border x:Name="AvisoSemCaixa" Style="{StaticResource Aviso}" Background="{StaticResource Ambar50}" BorderBrush="{StaticResource BordaAvisoAmbar}"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Ir para o caixa" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Ambar700}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="IrParaCaixa_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Text="O caixa de hoje ainda não foi aberto: não há vendas para fechar." Foreground="{StaticResource Ambar700}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Totais do dia -->
        <UniformGrid x:Name="Totais" Columns="4" Margin="0,0,-16,4">
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas hoje" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Total" Text="—" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="24" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Vendas realizadas" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Quantidade" Text="—" FontFamily="{StaticResource FonteTitulo}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Ticket médio" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <Border Style="{StaticResource EtiquetaPreco}" Margin="0,10,0,4">
                        <TextBlock x:Name="Ticket" Text="—" Style="{StaticResource EtiquetaPrecoTexto}" FontSize="24" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CartaoBorda}" Padding="22,20" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="Canceladas" Style="{StaticResource TextoSuave}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="Canceladas" Text="—" FontFamily="{StaticResource FonteTitulo}" FontSize="28" FontWeight="ExtraBold" Margin="0,10,0,0" />
                    <TextBlock x:Name="CanceladasValor" Style="{StaticResource TextoSuave}" FontSize="13" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid x:Name="GradeDia" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColunaDireita" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Conferência do dinheiro e fechamento -->
            <Border x:Name="CartaoConferencia" Style="{StaticResource CartaoBorda}" Padding="24,22" Margin="0,0,20,20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Dinheiro na gaveta" Style="{StaticResource TituloCartao}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource TextoSuave}" FontSize="13" Margin="0,0,0,12"
                               Text="Troco inicial mais as vendas em dinheiro (o troco devolvido já está descontado)." />
                    <StackPanel x:Name="ContaGaveta" />

                    <!-- Caixa aberto: contar e fechar -->
                    <StackPanel x:Name="PainelFechar" Margin="0,18,0,0">
                        <TextBlock Text="Dinheiro contado na gaveta (R$)" Style="{StaticResource Rotulo}" />
                        <Grid>
                            <TextBox x:Name="Contado" MaxLength="12" TextChanged="Contado_TextChanged" AutomationProperties.Name="Dinheiro contado na gaveta em reais" />
                            <TextBlock x:Name="DicaContado" Text="ex.: 350,00" Foreground="{StaticResource Placeholder}" FontSize="15"
                                       VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <TextBlock x:Name="ContadoErro" Style="{StaticResource ErroCampo}" />
                        <TextBlock x:Name="Diferenca" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" />

                        <TextBlock Text="Observação (opcional)" Style="{StaticResource Rotulo}" Margin="0,16,0,6" />
                        <TextBox x:Name="Observacao" MaxLength="300" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                 Padding="14,10" VerticalContentAlignment="Top" AutomationProperties.Name="Observação do fechamento" />

                        <Button x:Name="BotaoFechar" Style="{StaticResource BotaoPrimario}" Margin="0,18,0,0" Click="Fechar_Click"
                                AutomationProperties.Name="Fechar o caixa">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFechamento}" Foreground="White" Width="18" Margin="0,0,8,0" />
                                <TextBlock Text="Fechar o caixa" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource TextoSuave}" FontSize="12.5" Margin="0,8,0,0"
                                   Text="Depois do fechamento não dá para vender nem cancelar venda de hoje." />
                    </StackPanel>

                    <!-- Caixa já fechado -->
                    <StackPanel x:Name="PainelFechado" Margin="0,18,0,0" Visibility="Collapsed">
                        <Border Style="{StaticResource Aviso}" Background="{StaticResource Verde50}" BorderBrush="{StaticResource BordaAvisoVerde}" Margin="0">
                            <DockPanel>
                                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCheck}" Foreground="{StaticResource Verde700}"
                                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock x:Name="FechadoTexto" Foreground="{StaticResource Verde700}" FontSize="14" />
                            </DockPanel>
                        </Border>
                        <Button x:Name="BotaoReabrir" Content="Reabrir o caixa" Style="{StaticResource BotaoLink}" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Click="Reabrir_Click" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Por forma de pagamento + mais vendidos -->
            <StackPanel x:Name="ColunaResumo" Grid.Column="1">
                <Border Style="{StaticResource CartaoBorda}" Padding="24,22" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Por forma de pagamento" Style="{StaticResource TituloCartao}" Margin="0,0,0,8" />
                        <StackPanel x:Name="PorForma" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CartaoBorda}" Padding="24,22" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Mais vendidos hoje" Style="{StaticResource TituloCartao}" Margin="0,0,0,8" />
                        <StackPanel x:Name="MaisVendidosHoje" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Enviar o resumo por e-mail -->
        <Border Style="{StaticResource CartaoBorda}" Padding="24,22" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Enviar o resumo do dia" Style="{StaticResource TituloCartao}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource TextoSuave}" FontSize="13" Margin="0,0,0,14"
                           Text="Abre o seu programa de e-mail com o resumo já escrito; é só conferir e enviar. O endereço fica guardado neste computador." />
                <WrapPanel>
                    <StackPanel Width="320" Margin="0,0,12,0">
                        <TextBlock Text="E-mail da gerência" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="EmailResumo" MaxLength="200" AutomationProperties.Name="E-mail da gerência" />
                        <TextBlock x:Name="EmailResumoErro" Style="{StaticResource ErroCampo}" />
                    </StackPanel>
                    <Button Style="{StaticResource BotaoPrimario}" VerticalAlignment="Top" Margin="0,26,12,0" Click="EnviarEmail_Click"
                            AutomationProperties.Name="Enviar resumo por e-mail">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeEmail}" Foreground="White" Width="18" Margin="0,0,8,0" />
                            <TextBlock Text="Enviar por e-mail" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BotaoFantasma}" VerticalAlignment="Top" Margin="0,26,0,0" Click="CopiarResumo_Click"
                            AutomationProperties.Name="Copiar resumo">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCopiar}" Foreground="{StaticResource Toldo}" Width="18" Margin="0,0,8,0" />
                            <TextBlock Text="Copiar resumo" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Análise (só o gerente): vendas por dia, semana e mês -->
        <Border x:Name="CartaoAnalise" Style="{StaticResource CartaoBorda}" Padding="24,22" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Text="Vendas no período" Style="{StaticResource TituloCartao}" />
                </DockPanel>
                <TextBlock x:Name="AnaliseResumo" Style="{StaticResource TextoSuave}" FontSize="13" Margin="0,0,0,12" />
                <WrapPanel x:Name="Periodos" Margin="0,0,0,8" />
                <TextBlock x:Name="AnaliseErro" Foreground="{StaticResource Vermelho600}" FontSize="14" Margin="0,4,0,8" Visibility="Collapsed" />
                <Grid x:Name="GradeAnalise">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition x:Name="ColunaMaisVendidos" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="Barras" Margin="0,0,24,0" />
                    <StackPanel x:Name="BlocoMaisVendidos" Grid.Column="1">
                        <TextBlock Text="Mais vendidos no período" FontWeight="Bold" FontSize="14" Margin="0,4,0,6" />
                        <StackPanel x:Name="MaisVendidosPeriodo" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
