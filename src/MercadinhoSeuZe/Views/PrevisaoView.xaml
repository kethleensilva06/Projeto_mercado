<UserControl x:Class="MercadinhoSeuZe.Views.PrevisaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <!-- Previsão de compras (semana 7, só o gerente): quanto cada produto vende por dia, o que falta até a entrega e quanto
         pedir. Os números vêm de PrevisaoService (vendas dos últimos 28 dias e eventos_calendario) e de Models/Previsao.cs. -->
    <StackPanel>
        <!-- Cabeçalho -->
        <DockPanel Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Content="Atualizar" Style="{StaticResource BotaoFantasma}" Height="40" Padding="16,0"
                    VerticalAlignment="Bottom" Margin="0,0,0,6" Click="Atualizar_Click"
                    ToolTip="Ler de novo o estoque, as vendas e o calendário" AutomationProperties.Name="Atualizar a previsão" />
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Previsão de compras" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="Subtitulo" Text="Carregando…" Style="{StaticResource TextoSuave}" />
            </StackPanel>
        </DockPanel>

        <!-- Aviso do que é a previsão -->
        <Border Style="{StaticResource Aviso}" Background="{StaticResource Azul50}" BorderBrush="{StaticResource Azul600}">
            <DockPanel>
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Azul600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock Text="Previsão com as vendas dos últimos 28 dias e o calendário do banco. Não é garantia."
                           Foreground="{StaticResource Azul600}" FontSize="14" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Erro ao ler o banco -->
        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource Vermelho600}"
                Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="Atualizar_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Tabela de aviso (script ainda não rodado): a previsão segue sem ela -->
        <Border x:Name="AvisoTabelas" Style="{StaticResource Aviso}" Background="{StaticResource Ambar50}" BorderBrush="{StaticResource Ambar700}"
                Visibility="Collapsed">
            <DockPanel>
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Ambar700}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoTabelasTexto" Foreground="{StaticResource Ambar700}" FontSize="14" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Indicadores -->
        <Border Style="{StaticResource FaixaKpis}">
            <UniformGrid x:Name="Kpis" Rows="1" />
        </Border>

        <!-- Tabela de produtos e próximos eventos (lado a lado; empilhados na janela estreita) -->
        <StackPanel x:Name="Conteudo" />
    </StackPanel>
</UserControl>
